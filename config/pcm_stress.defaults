# Optional hardware experiment fragment, not the normal default profile.
# For a fresh sdkconfig: combine AFTER sdkconfig.defaults.
# For an existing sdkconfig: set these values through menuconfig.
CONFIG_STREAMOO_HARDWARE_TESTS=y
CONFIG_STREAMOO_DIAGNOSTICS=y
# CONFIG_STREAMOO_NETWORK_ENABLED is not set
CONFIG_STREAMOO_ENCODER_ENABLED=y
CONFIG_STREAMOO_DISPLAY_ENABLED=y
CONFIG_STREAMOO_UI_ENABLED=y
CONFIG_STREAMOO_AUDIO_CONTROL_TEST=y
CONFIG_STREAMOO_PCM_STALL_TEST=y
CONFIG_STREAMOO_PCM_TAP_DELAY_MS=100

# Isolate FIFO behavior from deliberate silence in file fixtures.
CONFIG_STREAMOO_SINE_FIXTURE_TEST=y
# CONFIG_STREAMOO_MP3_FIXTURE_TEST is not set
# CONFIG_STREAMOO_AAC_FIXTURE_TEST is not set
