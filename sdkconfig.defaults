# StreamOO - ESP32-S3-WROOM-1-N16R8 / ESP-IDF 6.1
# Kconfig defaults. ESP-IDF generates complete sdkconfig from these settings.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# SSD1322
CONFIG_STREAMOO_RESERVE_USB=y
CONFIG_STREAMOO_LCD_SPI_HOST=2
CONFIG_STREAMOO_LCD_MOSI=11
CONFIG_STREAMOO_LCD_SCLK=12
CONFIG_STREAMOO_LCD_CS=9
CONFIG_STREAMOO_LCD_DC=10
CONFIG_STREAMOO_LCD_RST=-1
CONFIG_STREAMOO_LCD_SPI_CLOCK_MHZ=10

# PCM5102A
CONFIG_STREAMOO_I2S_DOUT=48
CONFIG_STREAMOO_I2S_BCLK=47
CONFIG_STREAMOO_I2S_LRCLK=21

# Encoder: actual wiring confirmed by user, 2026-10-24 (reference schematic differs)
CONFIG_STREAMOO_ENCODER_GPIO_A=5
CONFIG_STREAMOO_ENCODER_GPIO_B=6
CONFIG_STREAMOO_ENCODER_GPIO_BUTTON=7
# CONFIG_STREAMOO_ENCODER_INTERNAL_PULLUP is not set
CONFIG_STREAMOO_ENCODER_REVERSED=y
CONFIG_STREAMOO_ENCODER_HALF_QUADRATURE=y
CONFIG_STREAMOO_ENCODER_MODE_A=y
# CONFIG_STREAMOO_ENCODER_MODE_B is not set

# Audio and DSP
CONFIG_STREAMOO_STREAM_BUFFER_KIB=256
CONFIG_STREAMOO_FFT_1024=y
# CONFIG_STREAMOO_FFT_2048 is not set
CONFIG_STREAMOO_DSP_ENABLE_SIMD=y

# Stage 04a: finite OLED bring-up test; disable for later application builds.
CONFIG_STREAMOO_LCD_SMOKE_TEST=y
CONFIG_STREAMOO_LCD_COLUMN_OFFSET=28
CONFIG_STREAMOO_LCD_REMAP=20

# Native Wi-Fi exceeds the old 1MiB factory app. NVS/PHY offsets unchanged.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# TLS handshake buffers in PSRAM; PCM/ISR remain internal.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# LAN-only mDNS advertisement, no browsing/CLI or AP responder.
CONFIG_MDNS_MAX_INTERFACES=2
CONFIG_MDNS_MAX_SERVICES=1
CONFIG_MDNS_ENABLE_BROWSE=n
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
CONFIG_MDNS_MULTIPLE_INSTANCE=n
CONFIG_MDNS_PREDEF_NETIF_AP=n
CONFIG_MDNS_PREDEF_NETIF_ETH=n
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

# Leave flash room for the extended native decoders; keep assertions enabled.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# Accept valid cross-signed chains using an existing trusted Mozilla root.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# SNTP supplies UTC; enforce real X.509 validity windows as well as signatures/names.
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
